{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:industrial-shadow:target-profile:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "collected_at", "runner_os", "runner_architecture", "cpu_count", "memory_bytes", "orchestrator_version", "cluster_uid_digest", "kubernetes_api_ca_digest", "aws_account_id", "aws_region", "s3_bucket", "s3_probe_prefix", "snapshot_object_storage_prefix", "backup_object_storage_prefix", "kms_key_id_digest", "backup_restore_receipt_digest", "backup_workload_identity_arn_digest", "snapshot_workload_identity_arn_digest", "oidc_issuer", "oidc_audience_digest", "oidc_human_client_id_digest", "oidc_service_client_ids_digest", "managed_postgresql_provider", "managed_postgresql_source_resource_digest", "managed_postgresql_restore_resource_digest", "managed_postgresql_source_coordinate_digest", "managed_postgresql_restore_coordinate_digest", "managed_postgresql_source_kms_key_digest", "managed_postgresql_restore_kms_key_digest", "managed_postgresql_source_ca_identifier_digest", "managed_postgresql_restore_ca_identifier_digest", "candidate_image", "build_digest", "simulator_build_digest", "deployment_plan_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "collected_at": {"type": "string", "format": "date-time"},
    "runner_os": {"type": "string", "minLength": 1},
    "runner_architecture": {"type": "string", "minLength": 1},
    "cpu_count": {"type": "integer", "minimum": 1},
    "memory_bytes": {"type": "integer", "minimum": 536870912},
    "orchestrator_version": {"type": "string", "minLength": 1},
    "cluster_uid_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "kubernetes_api_ca_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "aws_account_id": {"type": "string", "pattern": "^[0-9]{12}$"},
    "aws_region": {"type": "string", "pattern": "^[a-z]{2}(?:-gov)?-[a-z]+-[1-9][0-9]*$"},
    "s3_bucket": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"},
    "s3_probe_prefix": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$"},
    "snapshot_object_storage_prefix": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$"},
    "backup_object_storage_prefix": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$"},
    "kms_key_id_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "backup_restore_receipt_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "backup_workload_identity_arn_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "snapshot_workload_identity_arn_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "oidc_issuer": {"type": "string", "format": "uri", "pattern": "^https://"},
    "oidc_audience_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "oidc_human_client_id_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "oidc_service_client_ids_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "managed_postgresql_provider": {"enum": ["aws-rds"]},
    "managed_postgresql_source_resource_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "managed_postgresql_restore_resource_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "managed_postgresql_source_coordinate_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "managed_postgresql_restore_coordinate_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "managed_postgresql_source_kms_key_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "managed_postgresql_restore_kms_key_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "managed_postgresql_source_ca_identifier_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "managed_postgresql_restore_ca_identifier_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate_image": {"type": "string", "pattern": "^.+@sha256:[a-f0-9]{64}$"},
    "build_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "simulator_build_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "deployment_plan_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
