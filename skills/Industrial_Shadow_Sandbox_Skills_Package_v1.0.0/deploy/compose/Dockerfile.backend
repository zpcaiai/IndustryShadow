FROM python:3.12-slim@sha256:423ed6ab25b1921a477529254bfeeabf5855151dc2c3141699a1bfc852199fbf AS runtime
WORKDIR /app
RUN sed -i \
      -e 's|URIs: http://deb.debian.org/debian$|URIs: https://snapshot.debian.org/archive/debian/20260623T000000Z|' \
      -e 's|URIs: http://deb.debian.org/debian-security$|URIs: https://snapshot.debian.org/archive/debian-security/20260623T000000Z|' \
      /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends postgresql-client \
    && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.runtime.lock /app/backend/requirements.runtime.lock
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_DEFAULT_TIMEOUT=300
RUN pip install --no-cache-dir --retries 5 --require-hashes -r /app/backend/requirements.runtime.lock
COPY backend/src /app/backend/src
COPY services /app/services
COPY migrations /app/migrations
RUN mkdir -p /app/.runtime && chown -R 65532:65532 /app/.runtime
ENV PYTHONPATH=/app/backend/src:/app/services/simulator/src:/app/services/collector/src:/app/services/edge-gateway/src
USER 65532:65532
CMD ["uvicorn", "shadow_sandbox.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
